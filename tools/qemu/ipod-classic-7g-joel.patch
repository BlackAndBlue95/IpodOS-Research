diff --git a/include/hw/arm/ipod_classic/ipod_classic_eic.h b/include/hw/arm/ipod_classic/ipod_classic_eic.h
new file mode 100644
index 0000000..fbd6418
--- /dev/null
+++ b/include/hw/arm/ipod_classic/ipod_classic_eic.h
@@ -0,0 +1,41 @@
+/*
+ * S5L8702 external (GPIO) interrupt controller, 0x39a00000.
+ *
+ * Seven groups of 32 sources; GPIO pins map to groups 6..3 in reverse order and
+ * group g drives VIC line EINT(6 - g) (Rockbox s5l87xx.h). Per group, at
+ * +0x80/+0xa0/+0xc0/+0xe0 + 4*g: level, status (write 1 to clear), enable, type.
+ *
+ * The only source the machine drives is the LCD panel's frame marker (FMARK, the
+ * tearing-effect output) on GPIO 55: group 5, bit 15, VIC line 1. The retailOS's
+ * video presenter registers for it (0x081447fc -> 0x080404d0(55, ...)) and draws
+ * one frame per pulse. EIC_FMARK=0 turns the pulses off; EIC_FMARK_HZ sets the
+ * rate (60 by default). Everything else is a register latch.
+ */
+#ifndef HW_ARM_IPOD_CLASSIC_EIC_H
+#define HW_ARM_IPOD_CLASSIC_EIC_H
+
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_IPOD_CLASSIC_EIC "s5l8702.eic"
+OBJECT_DECLARE_SIMPLE_TYPE(IPodClassicEICState, IPOD_CLASSIC_EIC)
+
+#define EIC_MEM_SIZE  0x1000
+#define EIC_NREG      (EIC_MEM_SIZE / 4)
+#define EIC_NGROUPS   7
+
+struct IPodClassicEICState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq[EIC_NGROUPS];      /* group g -> VIC EINT(6 - g) */
+    uint32_t reg[EIC_NREG];
+    uint32_t stat[EIC_NGROUPS];
+    QEMUTimer *fmark;
+    uint64_t pulses;
+};
+
+#endif
