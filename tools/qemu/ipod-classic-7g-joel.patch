diff --git a/hw/arm/ipod_classic/ipod_classic_eic.c b/hw/arm/ipod_classic/ipod_classic_eic.c
new file mode 100644
index 0000000..0f67128
--- /dev/null
+++ b/hw/arm/ipod_classic/ipod_classic_eic.c
@@ -0,0 +1,187 @@
+/* See ipod_classic_eic.h. */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "migration/vmstate.h"
+#include "hw/core/cpu.h"
+#include "hw/arm/ipod_classic/ipod_classic_eic.h"
+
+#define EIC_LEVEL  0x80
+#define EIC_STAT   0xa0
+#define EIC_EN     0xc0
+#define EIC_TYPE   0xe0
+
+#define FMARK_GROUP 5
+#define FMARK_BIT   (1u << 15)
+
+static void eic_update(IPodClassicEICState *s)
+{
+    for (int g = 0; g < EIC_NGROUPS; g++) {
+        qemu_set_irq(s->irq[g], (s->stat[g] & s->reg[(EIC_EN >> 2) + g]) != 0);
+    }
+}
+
+static int fmark_hz(void)
+{
+    static int hz = -1;
+    if (hz < 0) {
+        const char *e = getenv("EIC_FMARK");
+        const char *r = getenv("EIC_FMARK_HZ");
+        hz = (e && *e == '0') ? 0 : ((r && *r) ? atoi(r) : 60);
+        if (hz) {
+            fprintf(stderr, "EIC: LCD frame marker on GPIO 55 at %d Hz\n", hz);
+        }
+    }
+    return hz;
+}
+
+extern int ipod_classic_panel_fmark;      /* ipod_classic_lcd.c: R090h FMKM, -1 unwritten */
+
+/* EIC_FMARK=panel: pulse only while the panel's frame marker output is on (R090h FMKM) */
+static bool panel_gated(void)
+{
+    static int gated = -1;
+    if (gated < 0) {
+        const char *e = getenv("EIC_FMARK");
+        gated = e && !strcmp(e, "panel");
+    }
+    return gated && ipod_classic_panel_fmark != 1;
+}
+
+static void eic_fmark(void *opaque)
+{
+    IPodClassicEICState *s = opaque;
+    int hz = fmark_hz();
+
+    /* the panel pulses whether or not anyone listens; the status latches only when enabled */
+    if ((s->reg[(EIC_EN >> 2) + FMARK_GROUP] & FMARK_BIT) && !panel_gated()) {
+        s->stat[FMARK_GROUP] |= FMARK_BIT;
+        s->pulses++;
+        if (s->pulses <= 3 || s->pulses % 3600 == 0) {
+            fprintf(stderr, "EIC: frame marker #%" PRIu64 "\n", s->pulses);
+        }
+        eic_update(s);
+    }
+    timer_mod(s->fmark, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000000LL / hz);
+}
+
+/* EICTRACE=1: every access to the frame marker's group, with the guest PC */
+static bool eic_trace(hwaddr offset)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("EICTRACE");
+        on = e && *e && *e != '0';
+    }
+    return on && (offset & 0x1f) == 4 * FMARK_GROUP && offset >= EIC_LEVEL;
+}
+
+static uint32_t eic_pc(void)
+{
+    CPUState *cs = current_cpu;
+    return cs ? (uint32_t)CPU_GET_CLASS(cs)->get_pc(cs) : 0;
+}
+
+static uint64_t eic_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IPodClassicEICState *s = opaque;
+    uint32_t v;
+
+    if (offset >= EIC_STAT && offset < EIC_STAT + 4 * EIC_NGROUPS) {
+        v = s->stat[(offset - EIC_STAT) >> 2];
+    } else {
+        v = offset < EIC_MEM_SIZE ? s->reg[offset >> 2] : 0;
+    }
+    if (eic_trace(offset)) {
+        fprintf(stderr, "EICTRACE rd +0x%03x -> 0x%08x pc~0x%08x\n", (unsigned)offset, v, eic_pc());
+    }
+    return v;
+}
+
+static void eic_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    IPodClassicEICState *s = opaque;
+
+    if (offset >= EIC_MEM_SIZE) {
+        return;
+    }
+    if (eic_trace(offset)) {
+        fprintf(stderr, "EICTRACE wr +0x%03x = 0x%08x pc~0x%08x\n", (unsigned)offset, (uint32_t)value, eic_pc());
+    }
+    if (offset >= EIC_STAT && offset < EIC_STAT + 4 * EIC_NGROUPS) {
+        /* write 1 to clear: the retailOS's EINT handler (IRAM 0x22002f94) writes the bit back */
+        s->stat[(offset - EIC_STAT) >> 2] &= ~(uint32_t)value;
+    } else {
+        s->reg[offset >> 2] = (uint32_t)value;
+    }
+    eic_update(s);
+}
+
+static const MemoryRegionOps eic_ops = {
+    .read = eic_read,
+    .write = eic_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static void eic_reset(DeviceState *dev)
+{
+    IPodClassicEICState *s = IPOD_CLASSIC_EIC(dev);
+
+    memset(s->reg, 0, sizeof(s->reg));
+    memset(s->stat, 0, sizeof(s->stat));
+    s->pulses = 0;
+    if (fmark_hz()) {
+        timer_mod(s->fmark, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000000LL / fmark_hz());
+    }
+    eic_update(s);
+}
+
+static void eic_init(Object *obj)
+{
+    IPodClassicEICState *s = IPOD_CLASSIC_EIC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &eic_ops, s, TYPE_IPOD_CLASSIC_EIC, EIC_MEM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    for (int g = 0; g < EIC_NGROUPS; g++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[g]);
+    }
+    s->fmark = timer_new_ns(QEMU_CLOCK_VIRTUAL, eic_fmark, s);
+}
+
+static const VMStateDescription vmstate_eic = {
+    .name = TYPE_IPOD_CLASSIC_EIC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(reg, IPodClassicEICState, EIC_NREG),
+        VMSTATE_UINT32_ARRAY(stat, IPodClassicEICState, EIC_NGROUPS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void eic_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "S5L8702 external interrupt controller";
+    dc->reset = eic_reset;
+    dc->vmsd = &vmstate_eic;
+    dc->user_creatable = false;
+}
+
+static const TypeInfo eic_info = {
+    .name = TYPE_IPOD_CLASSIC_EIC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IPodClassicEICState),
+    .instance_init = eic_init,
+    .class_init = eic_class_init,
+};
+
+static void eic_register_types(void)
+{
+    type_register_static(&eic_info);
+}
+
+type_init(eic_register_types)
